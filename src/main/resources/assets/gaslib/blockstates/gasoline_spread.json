{
  "multipart": [
    { "when": { "north_down": true }, "apply": { "model": "gaslib:block/gasoline_spread_north_down" } },
    { "when": { "north": true }, "apply": { "model": "gaslib:block/gasoline_spread_north" } },

    { "when": { "east_down": true }, "apply": { "model": "gaslib:block/gasoline_spread_east_down" } },
    { "when": { "east": true }, "apply": { "model": "gaslib:block/gasoline_spread_east" } },

    { "when": { "south_down": true }, "apply": { "model": "gaslib:block/gasoline_spread_south_down" } },
    { "when": { "south": true }, "apply": { "model": "gaslib:block/gasoline_spread_south" } },

    { "when": { "west_down": true }, "apply": { "model": "gaslib:block/gasoline_spread_west_down" } },
    { "when": { "west": true }, "apply": { "model": "gaslib:block/gasoline_spread_west" } },

    { "when": { "up": true }, "apply": { "model": "gaslib:block/gasoline_spread_up" } },
    { "when": { "down": true }, "apply": { "model": "gaslib:block/gasoline_spread_down" } }
  ]
}